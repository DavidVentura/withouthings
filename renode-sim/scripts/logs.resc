include @scripts/boot.resc

cpu AddHook 0x8f494 """
a=cpu.GetRegisterUnsafe(0).RawValue
s=''
i=0
while i<160:
    b=cpu.GetMachine().SystemBus.ReadByte(a+i)
    if b==0: break
    s+=chr(b); i+=1
print 'L494 '+s
"""
