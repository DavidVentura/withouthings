+/* The kernel's own form: pend PendSV and fence, with no SEV. The SDK's sends
+an event as well, which every caller in the image is missing (xTaskResumeAll
+@0x73276 pends and fences and nothing else); the tick ISR does send one, but it
+sends it from its own source, not from this macro. */
+#define portNVIC_INT_CTRL_REG   ( * ( ( volatile uint32_t * ) 0xe000ed04 ) )
+#define portNVIC_PENDSVSET_BIT  ( 1UL << 28UL )
+
 #define portYIELD() do                                                          \
 {                                                                               \
-    /* Set a PendSV to request a context switch. */                             \
-    SCB->ICSR = SCB_ICSR_PENDSVSET_Msk;                                         \
-    __SEV();                                                                    \
-    /* Barriers are normally not required but do ensure the code is completely  \
-    within the specified behaviour for the architecture. */                     \
+    portNVIC_INT_CTRL_REG = portNVIC_PENDSVSET_BIT;                             \
     __DSB();                                                                    \
     __ISB();                                                                    \
 }while (0)
