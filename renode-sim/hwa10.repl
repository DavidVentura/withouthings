nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

uart0: UART.NRF52840_UART @ sysbus 0x40002000
    easyDMA: false
    -> nvic@2

uart1: UART.NRF52840_UART @ sysbus 0x40028000
    easyDMA: true
    -> nvic@40

rtc0: Timers.NRF52840_RTC @ sysbus 0x4000B000
    numberOfEvents: 3
    -> nvic@11

// The firmware's uptime seconds come from RTC1's counter plus an overflow count
// it keeps in the OVRFLW handler, which the stock model never raises.
rtc1: Timers.NrfRtc @ sysbus 0x40011000
    numberOfEvents: 3
    -> nvic@17
    preinit:
        include @NrfRtc.cs

rtc2: Timers.NRF52840_RTC @ sysbus 0x40024000
    numberOfEvents: 4
    -> nvic@36

wdt: Timers.NRF52840_Watchdog @ sysbus 0x40010000
    -> nvic@16

ppi: Miscellaneous.NrfPpi @ sysbus 0x4001F000
    preinit:
        include @NrfPpi.cs

flash: Memory.MappedMemory @ sysbus 0x0
    size: 0x100000

// UICR. Only NRFFW[0] at 0x10001014 matters: it is the bootloader start address
// the MBR reads, and boot.resc leaves it erased so the MBR forwards to the
// SoftDevice. Memory rather than a tag because the update run arms and disarms
// the hand-off to the bootloader while the machine is running.
uicr: Memory.MappedMemory @ sysbus 0x10001000
    size: 0x400

ram: Memory.MappedMemory @ { sysbus 0x800000; sysbus 0x20000000 }
    size: 0x40000

clock: Miscellaneous.NrfClockReady @ sysbus 0x40000000
    -> nvic@0
    preinit:
        include @NrfClock.cs

twi0: I2C.NRF52840_I2C @ sysbus 0x40003000
    -> nvic@0x3

spi2: SPI.NrfSpimCapture @ sysbus 0x40023000
    PollReply: 0x66
    -> nvic@0x23
    preinit:
        include @NrfSpim.cs

// The accelerometer shares SPIM2 with the flash; the controller tells them
// apart by chip select, so this is registered at its CS pin number.
adxl367: Sensors.Adxl367 @ spi2 16
    0 -> gpio0@27
    preinit:
        include @NrfAdxl367.cs

spi3: SPI.OledSpimCapture @ sysbus 0x4002F000
    -> nvic@47
    preinit:
        include @OledSpim.cs

saadc: Analog.NrfSaadc @ sysbus 0x40007000
    -> nvic@7
    preinit:
        include @NrfSaadc.cs

nvmc: MTD.NrfNvmc @ sysbus 0x4001E000
    preinit:
        include @NrfNvmc.cs

temp: Sensors.NrfTemp @ sysbus 0x4000C000
    -> nvic@12
    preinit:
        include @NrfTemp.cs

pwm0: Miscellaneous.NrfPwm @ sysbus 0x4001C000
    -> nvic@28
    preinit:
        include @NrfPwm.cs

pwm1: Miscellaneous.NrfPwm @ sysbus 0x40021000
    -> nvic@33

pwm2: Miscellaneous.NrfPwm @ sysbus 0x40022000
    -> nvic@34

pwm3: Miscellaneous.NrfPwm @ sysbus 0x4002D000
    -> nvic@45

gpio0: GPIOPort.NrfGpio @ sysbus 0x50000500
    15 -> spi2@15
    16 -> spi2@16
    preinit:
        include @NrfGpio.cs

gpio1: GPIOPort.NrfGpio @ sysbus 0x50000800
    9 -> spi3@9

// The crown's click is a separate active-low input on P1.11 (pull-up, SENSE=Low);
// it is the fourth pin the app registers with the GPIOTE PORT dispatcher.
keys: Input.KeyPadInput @ sysbus
    keys: ["Enter"]
    activeLevel: ActiveLevel.Low
    0 -> gpio1@11
    preinit:
        include @KeyInput.cs

gpiote: GPIOPort.NRF52840_GPIOTasksEvents @ sysbus 0x40006000
    port0: gpio0
    port1: gpio1
    -> nvic@6

// Instance 1 at 0x40004000 is driven as SPIM1, not as TWI: the firmware arms
// TXD/RXD EasyDMA and TASKS_START on it for the MAX8617x optical front end,
// which is not modelled, so nothing is registered on the bus yet.
spi1: SPI.NrfSpimBus @ sysbus 0x40004000
    -> nvic@4
    preinit:
        include @NrfSpimBus.cs

// The optical front end is the only device on SPIM1; its chip select is P0.26
// and its interrupt is P1.14, which the driver configures as a pulled-up input
// with SENSE=Low at 0x52620 and registers with the PORT dispatcher at 0x527a8.
max86173: Sensors.Max86173 @ spi1 0
    0 -> gpio1@14
    preinit:
        include @NrfMax86173.cs

crown: Sensors.Crown @ twi0 0x79
    -> gpio1@13
    preinit:
        include @NrfCrown.cs

bq25180: Sensors.BQ25180 @ twi0 0x6A
    preinit:
        include @NrfBq25180.cs

tmp117: Sensors.TMP117 @ twi0 0x48
    preinit:
        include @NrfTmp117.cs

ads1115: Sensors.ADS1115 @ twi0 0x49
    preinit:
        include @NrfAds1115.cs

apds9306: Sensors.APDS9306 @ twi0 0x52
    preinit:
        include @NrfApds9306.cs

timer0: Timers.NRF52840_Timer @ sysbus 0x40008000
    numberOfEvents: 4
    -> nvic@8

timer1: Timers.NRF52840_Timer @ sysbus 0x40009000
    numberOfEvents: 4
    -> nvic@9

timer2: Timers.NRF52840_Timer @ sysbus 0x4000A000
    numberOfEvents: 4
    -> nvic@10

timer3: Timers.NRF52840_Timer @ sysbus 0x4001A000
    numberOfEvents: 6
    -> nvic@26

timer4: Timers.NRF52840_Timer @ sysbus 0x4001B000
    numberOfEvents: 6
    -> nvic@27

i2s: Sound.NRF52840_I2S @ sysbus 0x40025000
    -> nvic@37

pdm: Sound.NRF52840_PDM @ sysbus 0x4001D000
    -> nvic@29

radio: Wireless.NrfRadio @ sysbus 0x40001000
    -> nvic@1
    preinit:
        include @NrfRadio.cs

rng: Miscellaneous.NRF52840_RNG @ sysbus 0x4000D000
    -> nvic@13

ecb: Miscellaneous.NRF52840_ECB @ sysbus 0x4000E000
    -> nvic@14

egu0 : Miscellaneous.NRF52840_EGU @ sysbus 0x40014000
    -> nvic@20

egu1 : Miscellaneous.NRF52840_EGU @ sysbus 0x40015000
    -> nvic@21
    
egu2 : Miscellaneous.NRF52840_EGU @ sysbus 0x40016000
    -> nvic@22

egu3 : Miscellaneous.NRF52840_EGU @ sysbus 0x40017000
    -> nvic@23

egu4 : Miscellaneous.NRF52840_EGU @ sysbus 0x40018000
    -> nvic@24

egu5 : Miscellaneous.NRF52840_EGU @ sysbus 0x40019000
    -> nvic@25

sysbus:
    init:
        Tag <0x10000000, 0x10000FFF> "FICR"
        Tag <0x100000a0, 0x100000a3> "DEVICEADDRTYPE" 0x1 # random address
        Tag <0x100000a4, 0x100000a7> "DEVICEADDR[0]" 0xAABBCCDD
        Tag <0x10001200, 0x10001203> "PSELRESET"

wppPipe: Miscellaneous.WppPipe @ sysbus
    port: 7788
    evtPresentHook: 0x37370
    evtPollHook: 0x3739c
    evtBuffer: 0x20017ce0
    hvxThunk: 0x935b4
    wppServiceContext: 0x20017f28
    sdEventIrq: 22
    preinit:
        include @WppPipe.cs
